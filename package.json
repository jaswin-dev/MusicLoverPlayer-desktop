{
  "name": "musiclover-player",
  "version": "1.0.1",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "ffmpeg-static": "^5.3.0",
    "ffprobe-static": "^3.1.0",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.65.2",
    "music-metadata": "^11.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "vite": "^6.0.7",
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.musiclover.player",
    "productName": "MusicLover Player",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns",
      "extendInfo": {
        "CFBundleName": "MusicLover Player",
        "CFBundleDisplayName": "MusicLover Player",
        "NSLocalNetworkUsageDescription": "MusicLover Player uses your local network only when needed to discover or connect to devices on your network."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "MusicLover Player"
    },
    "directories": {
      "buildResources": "build"
    },
    "executableName": "MusicLover Player",
    "asar": true,
    "publish": [
      {
        "provider": "generic",
        "url": "https://raw.githubusercontent.com/jaswin-dev/musiclover-updates/main/desktop"
      }
    ]
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^45.3.1",
    "wait-on": "^8.0.2",
    "electron-builder": "^26.0.12"
  },
  "description": "MusicLover Player desktop music library and streaming application for macOS and Windows.",
  "author": "Jaswin Dev",
  "productName": "MusicLover Player"
}
