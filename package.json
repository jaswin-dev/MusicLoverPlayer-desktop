{
  "name": "musiclover-player",
  "version": "1.0.3",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "build": "vite build",
    "dist:mac": "npm run build && electron-builder --mac",
    "dist:win": "npm run build && electron-builder --win"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "lucide-react": "^0.468.0",
    "mediabunny": "^1.65.2",
    "music-metadata": "^11.16.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "electron-updater": "^6.6.2"
  },
  "build": {
    "appId": "com.musiclover.player",
    "productName": "MusicLover Player",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "arm64"
          ]
        }
      ],
      "category": "public.app-category.music",
      "icon": "build/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jaswin-dev",
        "repo": "MusicLoverPlayer-desktop"
      }
    ],
    "asar": true
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "electron": "^45.3.1",
    "wait-on": "^8.0.2",
    "electron-builder": "^26.0.12",
    "@vitejs/plugin-react": "^4.3.4",
    "vite": "^6.0.7"
  },
  "description": "MusicLover Player desktop music library and streaming application for macOS and Windows.",
  "author": "Jaswin Dev"
}
